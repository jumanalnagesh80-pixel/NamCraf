# NAMCRAFT Graphic Studio — environment variables
#
# The app works fully for guests using localStorage even without these set.
# To enable cloud sync, auth, and cross-device favorites/designs, connect a
# Supabase project (this is the same tech that powers "Lovable Cloud").
#
# 1. Create a project at https://supabase.com
# 2. Run the SQL in ./supabase/migrations/0001_init.sql in the SQL editor
# 3. Fill in the values below (exposed to the client, so use the ANON key only)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL used for canonical links, sitemap and OpenGraph tags.
VITE_SITE_URL=https://namcraft.studio
